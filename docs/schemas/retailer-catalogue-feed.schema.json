{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitsense.ai/schemas/retailer-catalogue-feed.schema.json",
  "title": "FitSense retailer catalogue feed",
  "type": "object",
  "required": ["products"],
  "additionalProperties": true,
  "properties": {
    "feedId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "region": { "type": "string", "minLength": 1, "maxLength": 80 },
    "notes": { "type": "string", "maxLength": 2000 },
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["productId", "brand", "model", "category", "fitType"],
        "additionalProperties": true,
        "properties": {
          "productId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "brand": { "type": "string", "minLength": 1, "maxLength": 80 },
          "model": { "type": "string", "minLength": 1, "maxLength": 120 },
          "category": { "type": "string", "minLength": 1, "maxLength": 40 },
          "fitType": { "type": "string", "minLength": 1, "maxLength": 40 },
          "sizeRangeEu": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" },
              "step": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "priceUsd": { "type": "number", "minimum": 0 },
          "description": { "type": "string", "maxLength": 2000 },
          "colorways": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string" }
          },
          "dataQuality": { "enum": ["verified", "unverified"] },
          "sku": { "type": "string", "maxLength": 80 },
          "storeUrl": { "type": "string" },
          "imageUrl": { "type": "string" }
        }
      }
    },
    "inventory": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["productId", "sizeSystem", "sizeLabel", "quantity"],
        "additionalProperties": true,
        "properties": {
          "productId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "sizeSystem": { "enum": ["uk", "us", "eu", "mondopoint"] },
          "sizeLabel": { "type": "string", "minLength": 1, "maxLength": 32 },
          "widthLabel": { "type": "string", "minLength": 1, "maxLength": 32 },
          "quantity": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
